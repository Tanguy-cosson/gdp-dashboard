def test_get_or_create_site_is_idempotent(conn):
    site_id_1 = db.get_or_create_site(conn, "FR-001", "Hopital Test", "FR")
    site_id_2 = db.get_or_create_site(conn, "FR-001", "Nom different", "BE")
    assert site_id_1 == site_id_2 == "FR-001"
    # La deuxième création n'a pas dû écraser le nom/pays d'origine
    row = conn.execute("SELECT site_name, country FROM SITES WHERE site_id = 'FR-001'").fetchone()
    assert row == ("Hopital Test", "FR")


def test_get_or_create_patient_and_visit(conn):
    db.get_or_create_site(conn, "FR-001")
    patient_id = db.get_or_create_patient(conn, "P-1", "U-1", "FR-001", "001", "M", 1980)
    visit_id = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    visit_id_again = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    assert visit_id == visit_id_again  # pas de doublon pour la même visite


def test_get_or_create_sample_assigns_barcode(conn):
    db.get_or_create_site(conn, "FR-001")
    patient_id = db.get_or_create_patient(conn, "P-1", "U-1", "FR-001", "001", "M", 1980)
    visit_id = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    sample_id = db.get_or_create_sample(conn, patient_id, visit_id, "SERUM")

    row = conn.execute("SELECT barcode_value FROM SAMPLES WHERE sample_id = ?", (sample_id,)).fetchone()
    assert row[0] == sample_id  # le code-barres = l'identifiant échantillon par défaut


def test_get_or_create_sample_one_per_patient_visit_type(conn):
    db.get_or_create_site(conn, "FR-001")
    patient_id = db.get_or_create_patient(conn, "P-1", "U-1", "FR-001", "001", "M", 1980)
    visit_id = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    s1 = db.get_or_create_sample(conn, patient_id, visit_id, "SERUM")
    s2 = db.get_or_create_sample(conn, patient_id, visit_id, "SERUM")
    s3 = db.get_or_create_sample(conn, patient_id, visit_id, "WHOLE_BLOOD")
    assert s1 == s2  # même patient/visite/type -> même échantillon
    assert s1 != s3  # type différent -> échantillon différent


def test_find_sample_by_barcode(conn):
    db.get_or_create_site(conn, "FR-001")
    patient_id = db.get_or_create_patient(conn, "P-1", "U-1", "FR-001", "001", "M", 1980)
    visit_id = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    sample_id = db.get_or_create_sample(conn, patient_id, visit_id, "SERUM")

    assert db.find_sample_by_barcode(conn, sample_id) == sample_id
    assert db.find_sample_by_barcode(conn, "  " + sample_id + "  ") == sample_id  # espaces tolérés
    assert db.find_sample_by_barcode(conn, "UNKNOWN-BARCODE") is None


