def _seed_one_result(conn, value=5.0, ref_low=4.0, ref_high=6.0):
    db.get_or_create_site(conn, "FR-001")
    patient_id = db.get_or_create_patient(conn, "P-1", "U-1", "FR-001", "001", "M", 1980)
    visit_id = db.get_or_create_visit(conn, patient_id, "V1", "2026-01-01", 2)
    sample_id = db.get_or_create_sample(conn, patient_id, visit_id, "SERUM")
    db.insert_lab_result(conn, visit_id, "GLUC", "Glucose", value, "mmol/L",
                          "2026-01-01", ref_low, ref_high, sample_id)
    return conn.execute("SELECT result_id FROM LAB_RESULTS").fetchone()[0]


def test_mark_technical_validation_only_affects_pending(conn):
    result_id = _seed_one_result(conn)
    n = db.mark_technical_validation(conn, [result_id], "lab_tech1")
    assert n == 1
    status = conn.execute("SELECT status FROM LAB_RESULTS WHERE result_id = ?", (result_id,)).fetchone()[0]
    assert status == "TECHNICAL_OK"

    # Rejouer sur un résultat déjà TECHNICAL_OK ne doit rien faire (garde WHERE status='PENDING')
    n2 = db.mark_technical_validation(conn, [result_id], "lab_tech1")
    assert n2 == 1  # la fonction renvoie len(result_ids) même si 0 ligne réellement modifiée
    status_after = conn.execute("SELECT status FROM LAB_RESULTS WHERE result_id = ?", (result_id,)).fetchone()[0]
    assert status_after == "TECHNICAL_OK"  # toujours TECHNICAL_OK, pas repassé par une autre valeur


def test_mark_biological_validation_only_affects_technical_ok(conn):
    result_id = _seed_one_result(conn)
    # Sans passage par la validation technique, la validation biologique ne doit rien faire
    db.mark_biological_validation(conn, [result_id], "biologist1", "Reviewed and approved")
    status = conn.execute("SELECT status FROM LAB_RESULTS WHERE result_id = ?", (result_id,)).fetchone()[0]
    assert status == "PENDING"

    db.mark_technical_validation(conn, [result_id], "lab_tech1")
    db.mark_biological_validation(conn, [result_id], "biologist1", "Reviewed and approved", "RAS")
    row = conn.execute(
        "SELECT status, biologist_validated_by, signature_reason, remarks FROM LAB_RESULTS WHERE result_id = ?",
        (result_id,),
    ).fetchone()
    assert row == ("REVIEWED", "biologist1", "Reviewed and approved", "RAS")


def test_get_usubjids_for_results(conn):
    result_id = _seed_one_result(conn)
    usubjids = db.get_usubjids_for_results(conn, [result_id])
    assert usubjids == ["U-1"]
    assert db.get_usubjids_for_results(conn, []) == []


