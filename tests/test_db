def test_record_login_failure_locks_after_threshold(conn):
    from constants import LOGIN_LOCKOUT_MINUTES, LOGIN_LOCKOUT_THRESHOLD
    db.create_user(conn, "newuser", "New User", "PHYSICIAN", "n@example.com", "fakehash")

    locked = False
    for _ in range(LOGIN_LOCKOUT_THRESHOLD):
        locked = db.record_login_failure(conn, "newuser", LOGIN_LOCKOUT_THRESHOLD, LOGIN_LOCKOUT_MINUTES)
    assert locked is True

    row = conn.execute("SELECT locked_until, failed_login_count FROM USERS WHERE username = ?",
                        ("newuser",)).fetchone()
    assert row[0] is not None
    assert row[1] == LOGIN_LOCKOUT_THRESHOLD


def test_record_login_success_resets_lockout(conn):
    from constants import LOGIN_LOCKOUT_MINUTES, LOGIN_LOCKOUT_THRESHOLD
    db.create_user(conn, "newuser", "New User", "PHYSICIAN", "n@example.com", "fakehash")
    db.record_login_failure(conn, "newuser", LOGIN_LOCKOUT_THRESHOLD, LOGIN_LOCKOUT_MINUTES)
    db.record_login_success(conn, "newuser")

    row = conn.execute("SELECT locked_until, failed_login_count FROM USERS WHERE username = ?",
                        ("newuser",)).fetchone()
    assert row == (None, 0)


