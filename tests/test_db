# Réinitialisation de mot de passe par jeton
# ---------------------------------------------------------------------
def test_password_reset_token_roundtrip(conn):
    db.create_user(conn, "newuser", "New User", "PHYSICIAN", "n@example.com", "fakehash")
    db.create_password_reset_token(conn, "newuser", "tok123", expires_minutes=60)

    username = db.consume_password_reset_token(conn, "tok123")
    assert username == "newuser"

    # Un jeton déjà consommé ne doit plus fonctionner
    assert db.consume_password_reset_token(conn, "tok123") is None


def test_password_reset_token_expired(conn):
    db.create_user(conn, "newuser", "New User", "PHYSICIAN", "n@example.com", "fakehash")
    conn.execute(
        "INSERT INTO PASSWORD_RESET_TOKENS (token, username, expires_at) VALUES (?, ?, ?)",
        ("expired_tok", "newuser", "2000-01-01T00:00:00+00:00"),
    )
    conn.commit()
    assert db.consume_password_reset_token(conn, "expired_tok") is None
